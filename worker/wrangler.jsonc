{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "beautybyalaena-inquiry",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "routes": [
    { "pattern": "beautybyalaena.com/api/inquiry", "zone_name": "beautybyalaena.com" },
    { "pattern": "www.beautybyalaena.com/api/inquiry", "zone_name": "beautybyalaena.com" }
  ],
  // Free-plan sending: Email Routing is enabled on forms.beautybyalaena.com (apex MX stays on Google),
  // and recipients must be verified Email Routing destination addresses on the account.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "FROM_ADDRESS": "inquiries@forms.beautybyalaena.com",
    "TO_ADDRESS": "beautybyalaena@gmail.com",
    "CC_ADDRESS": "littlems4god@gmail.com",
    "PUBLIC_CONTACT": "beautybyalaena@gmail.com"
  }
}
